# ============================================================
# OpenFederation PDS — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# For Railway deployment, set these as service variables in the Dashboard.

# --- Server ---
PORT=3000
# IMPORTANT: every fail-closed startup check (JWT secret strength, key
# encryption secret, SMTP, database TLS) only applies when this is exactly
# "production". A deployment that keeps "development" here, or leaves
# NODE_ENV unset, starts with those checks off. Set NODE_ENV=production on
# every deployed environment, staging included.
NODE_ENV=development

# --- Database ---
# Railway: auto-configured when you add a PostgreSQL service.
# Use the Railway reference variables: ${{Postgres.PGHOST}}, etc.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openfederation_pds
DB_USER=postgres
DB_PASSWORD=
# Production warns when this is off and the database is not on this machine or a
# private platform network (*.internal, e.g. Railway's).
DB_SSL=false
# When DB_SSL=true, set to false only if using self-signed certificates (not recommended for production).
# DB_SSL_REJECT_UNAUTHORIZED=false
DB_MAX_POOL_SIZE=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Integration tests REQUIRE a dedicated database. Must differ from DB_NAME.
# Create it with: createdb -U postgres openfederation_pds_test
TEST_DB_NAME=openfederation_pds_test

# --- PDS Identity ---
PDS_HOSTNAME=pds.openfederation.net
PDS_SERVICE_URL=https://pds.openfederation.net

# --- PLC Directory ---
# For local development, run: npm run plc:dev (starts on port 2582)
# For Railway production: https://plc.openfederation.net (our own PLC service)
# For public PLC directory: https://plc.directory
PLC_DIRECTORY_URL=http://localhost:2582

# --- Handle Suffix ---
HANDLE_SUFFIX=.openfederation.net

# --- Auth ---
# REQUIRED: Random string, at least 32 characters. Server refuses to start in production without this.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Seconds the token a session has just rotated away is still honoured, so two
# tabs refreshing at once both continue. After it, a rotated token is treated
# as stolen and every session is revoked. 0 disables the window.
REFRESH_REUSE_GRACE_SECONDS=10
INVITE_REQUIRED=true

# --- Key Encryption ---
# REQUIRED for production: Encrypts recovery and signing keys at rest.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_SECRET=
# During a rotation only (docs/HARDENING.md): the old secret, so keys not yet
# re-encrypted still open. Remove once scripts/rotate-key-encryption-secret.ts --apply ran.
# KEY_ENCRYPTION_SECRET_PREVIOUS=

# --- CORS ---
# Comma-separated origins allowed to call the PDS API.
# For Railway: set to your web UI service URL (e.g., https://your-web-ui.up.railway.app)
CORS_ORIGINS=http://localhost:3001

# --- Bootstrap Admin ---
# On first startup (with database connected), the PDS will create an admin user
# with these credentials if all three are set. The account is auto-approved and
# granted admin + moderator + partner-manager + auditor + user roles. You can
# then log in via the web UI.
#
# Set all three values together. Startup fails closed if the configuration is
# partial, the password is weak, or the password is a repository-known default.
# Docker Compose requires explicit, deployment-unique values for the first boot.
#
# After initial setup you can remove these variables — the admin account persists
# in the database. On a later bootstrap, both normalized identifiers must match
# the same existing account before any approval or role changes are applied.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_HANDLE=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Email ---
# See docs/EMAIL.md for the three supported paths (transactional provider,
# Google Workspace, self-hosted MTA). SMTP unset = mail logged to console.
# Production refuses to boot without SMTP unless ALLOW_NO_EMAIL=true states
# the choice explicitly.
#ALLOW_NO_EMAIL=true
# Enables /webhooks/email/{postmark,resend,ses} for bounce/complaint
# suppression. Unset = the routes do not exist.
#EMAIL_WEBHOOK_TOKEN=
# What an unverified email blocks: off | advisory | require-for-write |
# require-for-login. Default advisory. See docs/EMAIL.md.
#EMAIL_VERIFICATION_POLICY=advisory

# --- Pseudonyms ---
# Anonymous-credential tokens each pseudonym-capable account can collect per month.
# Custody modes (docs/adr/ADR-003-custody-modes.md). A profile sets defaults
# for the three settings after it; each can be set on its own.
#OPENFEDERATION_PROFILE=community   # or privacy
#IDENTITY_CUSTODY_ALLOWED=custodial,assisted,self
#IDENTITY_CUSTODY_DEFAULT=custodial
#PSEUDONYMS_ENABLED=true

#PSEUDONYM_TOKENS_PER_EPOCH=20
# Days a new pseudonym is rate-limited (0 = no probation).
#PSEUDONYM_PROBATION_DAYS=7
# Writes per day a pseudonym on probation may make.
#PSEUDONYM_PROBATION_DAILY_WRITES=20

# --- Accounts moving in from another PDS (#265) ---
# Users: open | invite (same rules as sign-up) | closed. Default: invite.
#MIGRATION_ACCOUNTS=invite
# Pseudonyms: open | token (a blind creation token, as for creating one) | closed.
# Never an invite code: a code can say who handed it out. Default: open.
#MIGRATION_PSEUDONYMS=open
# Communities: open | invite | closed. Default: invite.
#MIGRATION_COMMUNITIES=invite
# Days between clean-up sweeps of incoming accounts that never activated here
# and whose DID points elsewhere; a copy goes only after two sweeps in a row
# find it so. 0 disables. The copy left behind by a move away is never swept.
#MIGRATION_CLEANUP_DAYS=7

# Seconds in-flight requests get to finish on SIGTERM/SIGINT before the
# database pool is closed.
#SHUTDOWN_TIMEOUT_SECONDS=20

# Accept a governance proof for a chain with no adapter in CHAIN_ADAPTERS on the
# oracle's word. Off by default: such a proof is answered "not verified".
#ORACLE_TRUST_UNVERIFIED_PROOFS=false

# --- Rate limits ---
# Every request, per IP, per minute. Applies to all traffic, so raise it for a
# deployment whose clients share an egress IP (a corporate NAT, a mobile
# carrier, a reverse proxy that does not forward the real address).
GLOBAL_RATE_LIMIT=120
# See CLAUDE.md for the per-endpoint limits: AUTH_RATE_LIMIT,
# REGISTRATION_RATE_LIMIT, CREATE_RATE_LIMIT, WALLET_SIGN_RATE_LIMIT,
# SERVICE_AUTH_RATE_LIMIT.

# --- Partner API ---
# Allows trusted third-party apps to register users without invite codes.
# Keys are created via the admin API endpoint (net.openfederation.partner.createKey).
PARTNER_API_ENABLED=true
PARTNER_DEFAULT_RATE_LIMIT=100

# --- ATProto OAuth ---
# OAuth is enabled by default. Set to false to disable OAuth endpoints.
OAUTH_ENABLED=true
# DPoP nonce signing secret (hex). Must be same across all instances.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_DPOP_SECRET=
# ES256 signing key for OAuth tokens (JWK JSON, one line). Required in production
# when OAuth is on (the server refuses to start without it); generated per run in dev.
# Generate one: node -e "const k=require('crypto').generateKeyPairSync('ec',{namedCurve:'P-256'}).privateKey.export({format:'jwk'});console.log(JSON.stringify({...k,alg:'ES256',kid:'oauth-signing-key'}))"
OAUTH_SIGNING_KEY=
# Comma-separated list of trusted OAuth client_id URLs (optional).
OAUTH_TRUSTED_CLIENTS=
# Redis URL for OAuth replay protection. Without it protection is per process (a
# production warning): required before running more than one instance.
# For Railway: add a Redis service and use ${{Redis.REDIS_URL}}
REDIS_URL=

# --- Email (SMTP) ---
# When SMTP_HOST is set, emails are sent via SMTP.
# When unset, emails are logged to console (development mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@openfederation.net

# --- Express Trust Proxy ---
# Number of proxy hops to trust for X-Forwarded-For (default: 1)
# Set to 2 for Cloudflare + Railway, or true to trust all proxies
EXPRESS_TRUST_PROXY=1

# --- ActivityPub ---
# ActivityPub identity layer is enabled by default.
# Set to false to disable AP actor endpoints and WebFinger AP links.
ACTIVITYPUB_ENABLED=true

# --- Federation ---
# Peer PDS discovery and cross-PDS federation.
# Comma-separated list of peer PDS base URLs (exclude this PDS's own URL).
FEDERATION_PEERS_ENABLED=true
PEER_PDS_URLS=
FEDERATION_CACHE_TTL_MS=300000
# Web UI URL used in federation metadata (optional).
WEB_UI_URL=

# --- Blob Storage ---
# Blob storage for avatars and banners.
# BLOB_STORAGE=local uses BLOB_STORAGE_PATH on disk; =s3 uses AWS S3 (or compatible).
BLOB_STORAGE=local
BLOB_STORAGE_PATH=./data/blobs
# Maximum blob size in bytes (default: 1048576 = 1MB).
BLOB_MAX_SIZE=1048576
# S3-compatible blob storage (only used when BLOB_STORAGE=s3).
BLOB_S3_BUCKET=
BLOB_S3_REGION=us-east-1
BLOB_S3_ENDPOINT=
BLOB_S3_ACCESS_KEY_ID=
BLOB_S3_SECRET_ACCESS_KEY=

# --- Chain Proof Verification ---
# Comma-separated chain adapters for on-chain governance proof verification.
# Format: chainId=rpcUrl (CAIP-2 chain IDs). RPC URLs may contain API keys — treat as secrets.
# Example: eip155:137=https://polygon-rpc.com/v2/YOUR_KEY,eip155:1=https://eth-mainnet.alchemyapi.io/v2/YOUR_KEY
CHAIN_ADAPTERS=

# How long a registered attestor gets to notarize ("anchor") a governance
# decision before the attempt is recorded as failed and retried on the next
# resolution. Anchoring never blocks or changes a decision; this only bounds
# how long a resolving request will wait on a notary. Default 5000 (ms).
GOVERNANCE_ANCHOR_TIMEOUT_MS=

# --- Export Scheduler ---
# Background scheduler for community/user data exports.
# Disabled by default; enable to allow scheduled export jobs.
EXPORT_SCHEDULER_ENABLED=false
EXPORT_CHECK_INTERVAL_MS=300000

# Longest a custodial wallet signing consent may last, in hours (default 24;
# a consent lasts 1 hour unless the dApp asks for longer).
# WALLET_CONSENT_MAX_HOURS=24

# Security contact(s) for /.well-known/security.txt (RFC 9116): comma-separated
# email addresses or https URLs. The project's advisory form is always listed too.
# SECURITY_CONTACT=security@example.com
