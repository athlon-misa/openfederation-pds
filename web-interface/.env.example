# PDS API URL — the URL of your OpenFederation PDS server
# For Railway: use the PDS service's public URL (e.g., https://your-pds.up.railway.app)
# For local development: http://localhost:3000 (or 8080 if configured)
NEXT_PUBLIC_PDS_URL=http://localhost:3000

# Optional: that server's service DID (the `did` its com.atproto.server.describeServer
# answers, e.g. did:web:pds.example.com). Pen-name logins are signed for it. When set,
# the pen-name pages refuse to sign in to, or create a pen name on, a server at
# NEXT_PUBLIC_PDS_URL that names another DID. Unset: the DID the server names is used.
# NEXT_PUBLIC_PDS_SERVICE_DID=did:web:pds.example.com
