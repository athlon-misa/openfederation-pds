# Live mode for the stage demo: copy to demo/stage/.live.env (git-ignored)
# and fill in. Environment variables of the same name override this file.
# Run with: npm run demo -- --live

# Servers and directory. These are the defaults; override them to rehearse
# against other servers (e.g. two local PDSes and the dev PLC).
DEMO_PLC_URL=https://plc.openfederation.net
DEMO_PDS_A_URL=https://pds.openfederation.net
DEMO_PDS_B_URL=https://pds.grvty.app

# Elena, the reporter: an approved account on server A, kept fresh for the show.
# Handle or email to sign in with, its password, and its DID (checked at sign-in).
DEMO_ELENA_HANDLE=elena.example.net
DEMO_ELENA_PASSWORD=change-me
DEMO_ELENA_DID=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx

# Marko, who tries to claim Night Desk: only his public DID is used.
# Give the DID, or a handle to resolve on server A.
DEMO_MARKO_DID=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx
# DEMO_MARKO_HANDLE=marko.example.net

# Rehearsal accounts on server A, used instead of Elena's with
# `npm run demo -- --live --rehearsal` (account 1) or `--rehearsal=2`.
# In a rehearsal Night Desk's words are kept in demo/stage/.live/rehearsals.json
# so `npm run demo -- --cleanup` can delete its accounts and tombstone its DID.
DEMO_REHEARSAL_1_HANDLE=rehearsal1.example.net
DEMO_REHEARSAL_1_PASSWORD=change-me
DEMO_REHEARSAL_1_DID=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx
# DEMO_REHEARSAL_2_HANDLE=
# DEMO_REHEARSAL_2_PASSWORD=
# DEMO_REHEARSAL_2_DID=

# Same as --rehearsal=N; leave unset for the show.
# DEMO_REHEARSAL=1
