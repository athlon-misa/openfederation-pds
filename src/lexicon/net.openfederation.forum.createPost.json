{
  "lexicon": 1,
  "id": "net.openfederation.forum.createPost",
  "revision": 1,
  "description": "Create a forum post/reply. Member-only; writes a net.openfederation.forum.post record to the caller's repo.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["community", "root", "text"],
          "properties": {
            "community": { "type": "string", "format": "did" },
            "root": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
            "parent": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
            "text": { "type": "string", "maxLength": 10000 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid", "rkey"],
          "properties": {
            "uri": { "type": "string" },
            "cid": { "type": "string" },
            "rkey": { "type": "string" }
          }
        }
      }
    }
  }
}
