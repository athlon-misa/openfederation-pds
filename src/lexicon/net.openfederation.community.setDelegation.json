{
  "lexicon": 1,
  "id": "net.openfederation.community.setDelegation",
  "revision": 3,
  "description": "Delegate your governance vote to another member.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "communityDid": {
              "type": "string"
            },
            "delegateDid": {
              "type": "string"
            }
          },
          "required": [
            "communityDid",
            "delegateDid"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "uri": {
              "type": "string"
            },
            "cid": {
              "type": "string"
            },
            "rkey": {
              "type": "string"
            }
          },
          "required": [
            "uri",
            "cid",
            "rkey"
          ]
        }
      },
      "errors": [
        {
          "name": "NotMember",
          "description": "Referenced DID is not a member of this community."
        },
        {
          "name": "CommunityMoved",
          "description": "The community has moved to another PDS; this copy is read-only (#267)."
        },
        {
          "name": "CommunityImporting",
          "description": "The community is still arriving here and is not active yet (#267)."
        }
      ]
    }
  }
}
