{
  "lexicon": 1,
  "id": "net.openfederation.forum.createThread",
  "revision": 2,
  "description": "Create a forum thread in a community. Member-only; writes a net.openfederation.forum.thread record to the caller's repo.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["community", "title"],
          "properties": {
            "community": { "type": "string", "format": "did" },
            "title": { "type": "string", "maxLength": 300 },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid", "rkey"],
          "properties": {
            "uri": { "type": "string" },
            "cid": { "type": "string" },
            "rkey": { "type": "string" }
          }
        }
      },
      "errors": [
        {
          "name": "NotMember",
          "description": "Caller is not a member of this community."
        },
        {
          "name": "Forbidden",
          "description": "Caller does not have the required community permission."
        }
      ]
    }
  }
}
