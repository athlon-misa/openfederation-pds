{
  "lexicon": 1,
  "id": "net.openfederation.calendar.listRsvps",
  "revision": 5,
  "description": "List RSVPs for an event with status counts.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "event"
        ],
        "properties": {
          "event": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "errors": [
        {
          "name": "NotFound",
          "description": "Community not found or not readable."
        },
        {
          "name": "CommunityTakenDown",
          "description": "The community has been taken down."
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "counts",
            "rsvps"
          ],
          "properties": {
            "counts": {
              "type": "ref",
              "ref": "#rsvpCounts"
            },
            "rsvps": {
              "type": "array",
              "items": {
                "type": "unknown"
              }
            },
            "cursor": {
              "type": "string",
              "description": "Pass back to fetch the next page. Absent on the last page."
            }
          }
        }
      }
    },
    "rsvpCounts": {
      "type": "object",
      "description": "RSVP totals by status.",
      "required": [
        "going",
        "interested",
        "notgoing"
      ],
      "properties": {
        "going": {
          "type": "integer"
        },
        "interested": {
          "type": "integer"
        },
        "notgoing": {
          "type": "integer"
        }
      }
    }
  }
}
