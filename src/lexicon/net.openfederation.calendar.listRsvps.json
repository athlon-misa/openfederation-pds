{
  "lexicon": 1,
  "id": "net.openfederation.calendar.listRsvps",
  "revision": 3,
  "description": "List RSVPs for an event with status counts.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["event"],
        "properties": {
          "event": { "type": "string" }
        }
      },
      "errors": [
        { "name": "NotFound", "description": "Community not found or not readable." }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["counts", "rsvps"],
          "properties": {
            "counts": {
              "type": "ref",
              "ref": "#rsvpCounts"
            },
            "rsvps": {
              "type": "array",
              "items": { "type": "unknown" }
            }
          }
        }
      }
    },
    "rsvpCounts": {
      "type": "object",
      "description": "RSVP totals by status.",
      "required": ["going", "interested", "notgoing"],
      "properties": {
        "going": { "type": "integer" },
        "interested": { "type": "integer" },
        "notgoing": { "type": "integer" }
      }
    }
  }
}
