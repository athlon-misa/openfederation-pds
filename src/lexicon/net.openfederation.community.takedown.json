{
  "lexicon": 1,
  "id": "net.openfederation.community.takedown",
  "revision": 2,
  "description": "Take down a community with a standard takedown (docs/FAIR-USE.md). Requires admin role. The owner is emailed a private export link and the data is deleted after 30 days. Use admin.takedown for a hard takedown.",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Standard takedown of a community: hidden at once, owner export for 30 days, then deletion.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "did": {
              "type": "string",
              "description": "The DID of the community to take down."
            },
            "reason": {
              "type": "string",
              "description": "Optional reason for the takedown."
            }
          },
          "required": [
            "did"
          ]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "did": {
              "type": "string",
              "description": "The community DID."
            },
            "status": {
              "type": "string",
              "description": "The new status, always 'takendown'."
            },
            "reason": {
              "type": "string",
              "description": "The reason for takedown, or null if not provided."
            },
            "deleteAfter": {
              "type": "string",
              "format": "datetime",
              "description": "When the data will be deleted."
            }
          },
          "required": [
            "did",
            "status"
          ]
        }
      },
      "errors": [
        {
          "name": "InvalidRequest",
          "description": "Missing or invalid DID."
        },
        {
          "name": "NotFound",
          "description": "Community not found."
        },
        {
          "name": "AlreadyTakenDown",
          "description": "The community has already been taken down."
        }
      ]
    }
  }
}
