{
  "lexicon": 1,
  "id": "net.openfederation.forum.listThreads",
  "revision": 1,
  "description": "List forum threads in a community, newest activity first.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["community"],
        "properties": {
          "community": { "type": "string", "format": "did" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "before": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "threads": { "type": "array", "items": { "type": "unknown" } },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
