{
  "lexicon": 1,
  "id": "net.openfederation.calendar.listEvents",
  "revision": 4,
  "description": "List a community's events.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "community"
        ],
        "properties": {
          "community": {
            "type": "string",
            "format": "did"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 200
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "errors": [
        {
          "name": "NotFound",
          "description": "Community not found or not readable."
        },
        {
          "name": "CommunityTakenDown",
          "description": "The community has been taken down."
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "unknown"
              }
            },
            "cursor": {
              "type": "string",
              "description": "Pass back to fetch the next page. Absent on the last page."
            }
          }
        }
      }
    }
  }
}
