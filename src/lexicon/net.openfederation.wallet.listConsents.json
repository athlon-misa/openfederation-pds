{
  "lexicon": 1,
  "id": "net.openfederation.wallet.listConsents",
  "revision": 3,
  "description": "List the authenticated user's active (unrevoked, unexpired) Tier 1 signing consent grants.",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "consents"
          ],
          "properties": {
            "consents": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#consentEntry"
              }
            }
          }
        }
      }
    },
    "consentEntry": {
      "type": "object",
      "description": "Single active Tier 1 signing consent grant.",
      "required": [
        "id",
        "dappOrigin",
        "grantedAt",
        "expiresAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "dappOrigin": {
          "type": "string"
        },
        "chain": {
          "type": "string"
        },
        "walletAddress": {
          "type": "string"
        },
        "grantedAt": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "allowedContracts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Contracts (or Solana programs) transactions may go to. Absent: messages only."
        },
        "maxValuePerTx": {
          "type": "string",
          "description": "Most value one transaction may move (wei). Absent: none."
        },
        "maxTotalValue": {
          "type": "string",
          "description": "Most value all transactions together may move (wei)."
        },
        "spentValue": {
          "type": "string",
          "description": "Value moved so far under this consent (wei)."
        }
      }
    }
  }
}
