{
  "lexicon": 1,
  "id": "net.openfederation.calendar.rsvp",
  "revision": 2,
  "description": "RSVP to a community event. Writes a community.lexicon.calendar.rsvp record to the caller's repo.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["community", "event", "status"],
          "properties": {
            "community": { "type": "string", "format": "did" },
            "event": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
            "status": { "type": "string", "knownValues": ["going", "interested", "notgoing"] }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid", "rkey"],
          "properties": {
            "uri": { "type": "string" },
            "cid": { "type": "string" },
            "rkey": { "type": "string" }
          }
        }
      },
      "errors": [
        {
          "name": "NotMember",
          "description": "Caller is not a member of this community."
        },
        {
          "name": "Forbidden",
          "description": "Caller does not have the required community permission."
        }
      ]
    }
  }
}
