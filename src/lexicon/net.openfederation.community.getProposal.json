{
  "lexicon": 1,
  "id": "net.openfederation.community.getProposal",
  "revision": 4,
  "description": "Get a specific governance proposal.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "communityDid": {
            "type": "string"
          },
          "rkey": {
            "type": "string"
          }
        },
        "required": [
          "communityDid",
          "rkey"
        ]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "#output"
        }
      },
      "errors": [
        {
          "name": "ProposalNotFound",
          "description": "No proposal with given rkey."
        },
        {
          "name": "NotFound",
          "description": "Community not found or not readable."
        }
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "rkey": {
          "type": "string"
        },
        "targetCollection": {
          "type": "string"
        },
        "targetRkey": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "proposedRecord": {
          "type": "unknown"
        },
        "proposedBy": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "description": "open, pending-application (passed, waiting out the timelock), objected (application held by a signed objection), approved (applied), rejected, or expired."
        },
        "applyAt": {
          "type": "string",
          "description": "End of the objection window; the earliest instant the approved change is applied. Present while status is pending-application or objected."
        },
        "appliedAt": {
          "type": "string",
          "description": "When the approved change was actually applied."
        },
        "objections": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#objection"
          },
          "description": "Non-authoritative read cache of the countable objections holding this application. The authoritative set is the objector-signed net.openfederation.governance.objection records."
        },
        "votesFor": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Non-authoritative read cache of voters who voted for. The authoritative tally is the set of voter-signed vote records."
        },
        "votesAgainst": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Non-authoritative read cache of voters who voted against."
        },
        "createdAt": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "resolvedAt": {
          "type": "string"
        },
        "evidenceModel": {
          "type": "string",
          "description": "Set to 'vote-records' when this proposal's outcome is decided from voter-signed vote records. Absent on proposals created before that model."
        },
        "cidChain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lineage of proposal record CIDs a vote record may cite."
        },
        "decision": {
          "type": "ref",
          "ref": "#decisionRef",
          "description": "The net.openfederation.governance.decision record this proposal was resolved by. Present only on resolved evidence-model proposals."
        }
      },
      "required": [
        "uri",
        "rkey",
        "targetCollection",
        "action",
        "status"
      ]
    },
    "objection": {
      "type": "object",
      "required": [
        "objector",
        "record",
        "createdAt"
      ],
      "properties": {
        "objector": {
          "type": "string",
          "format": "did"
        },
        "record": {
          "type": "ref",
          "ref": "com.atproto.repo.strongRef"
        },
        "createdAt": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "decisionRef": {
      "type": "object",
      "required": [
        "uri",
        "cid",
        "rkey"
      ],
      "properties": {
        "uri": {
          "type": "string"
        },
        "cid": {
          "type": "string"
        },
        "rkey": {
          "type": "string"
        }
      }
    }
  }
}
