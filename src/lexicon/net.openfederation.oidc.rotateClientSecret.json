{
  "lexicon": 1,
  "id": "net.openfederation.oidc.rotateClientSecret",
  "revision": 1,
  "description": "Give a registered app a new client secret; the old one stops working at once. PDS admin only.",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Replace a client's secret.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "clientId"
          ],
          "properties": {
            "clientId": {
              "type": "string",
              "description": "The app's client ID."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "clientId",
            "clientSecret"
          ],
          "properties": {
            "clientId": {
              "type": "string",
              "description": "The app's client ID."
            },
            "clientSecret": {
              "type": "string",
              "description": "The new secret. Shown once."
            },
            "configuration": {
              "type": "string",
              "description": "The app's configuration with the new secret."
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidRequest",
          "description": "Missing or invalid input."
        },
        {
          "name": "Forbidden",
          "description": "PDS admin required."
        },
        {
          "name": "NotFound",
          "description": "No such client."
        }
      ]
    }
  }
}
