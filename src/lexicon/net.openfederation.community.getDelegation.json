{
  "lexicon": 1,
  "id": "net.openfederation.community.getDelegation",
  "revision": 2,
  "description": "Check delegation status for a member.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "communityDid": {
            "type": "string"
          },
          "memberDid": {
            "type": "string"
          }
        },
        "required": [
          "communityDid",
          "memberDid"
        ]
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "memberDid": {
              "type": "string"
            },
            "delegatedTo": {
              "type": "string"
            },
            "delegatedFrom": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "memberDid"
          ]
        }
      },
      "errors": [
        {
          "name": "NotFound",
          "description": "Community not found or not readable."
        },
        {
          "name": "CommunityTakenDown",
          "description": "The community has been taken down."
        }
      ]
    }
  }
}
