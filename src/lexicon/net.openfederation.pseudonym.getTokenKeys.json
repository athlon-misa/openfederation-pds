{
  "lexicon": 1,
  "id": "net.openfederation.pseudonym.getTokenKeys",
  "revision": 1,
  "description": "Public, unauthenticated epoch public keys for blind pseudonym creation tokens.",
  "defs": {
    "main": {
      "type": "query",
      "description": "List the accepted epoch keys (current, and previous if present). Clients fetch this anonymously and pin the keys.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "epoch": { "type": "string", "description": "UTC month, YYYY-MM." },
                  "publicKey": { "type": "string", "description": "base64url SPKI of the RSA-PSS 2048-bit epoch key." }
                },
                "required": ["epoch", "publicKey"]
              }
            }
          },
          "required": ["keys"]
        }
      },
      "errors": []
    }
  }
}
