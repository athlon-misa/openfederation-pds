{
  "name": "@open-federation/pseudonym",
  "version": "0.3.1",
  "description": "OpenFederation pseudonyms: anonymous identities with later, owner-only reveal",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/athlon-misa/openfederation-pds",
    "directory": "packages/openfederation-pseudonym"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepublishOnly": "node -e \"const fs=require('fs');const missing=['dist/index.js'].filter(f=>!fs.existsSync(f));if(missing.length){console.error('Not built, refusing to publish: '+missing.join(', '));process.exit(1)}\""
  },
  "dependencies": {
    "@cloudflare/blindrsa-ts": "0.4.6",
    "@ipld/dag-cbor": "^10.0.2",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
