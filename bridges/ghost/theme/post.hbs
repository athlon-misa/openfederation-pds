{{!< default}}
{{#post}}
<article class="article {{post_class}}">
    <header class="article-header">
        {{#if primary_tag}}<p class="label"><a href="{{primary_tag.url}}">{{primary_tag.name}}</a></p>{{/if}}
        <h1 class="article-title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="article-standfirst">{{custom_excerpt}}</p>{{/if}}
        <p class="meta">
            {{#foreach authors}}<a href="{{url}}">{{name}}</a>{{#unless @last}}, {{/unless}}{{/foreach}}
            · <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
            {{#if reading_time}} · {{reading_time}}{{/if}}
        </p>
    </header>
    {{#if feature_image}}
        <figure class="article-image kg-width-wide">
            <img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
        </figure>
    {{/if}}
    <section class="gh-content">
        {{content}}
    </section>
    {{#if comments}}
        <section class="article-comments">
            {{comments}}
        </section>
    {{/if}}
</article>
{{/post}}
