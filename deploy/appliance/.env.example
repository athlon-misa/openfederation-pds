# OpenFederation appliance settings (deploy/appliance/compose.yaml).
# Copy to .env next to compose.yaml. deploy/install.sh writes this file for you.
#
# This file holds addresses and the database password only. The server's own
# secrets are generated by the setup wizard on first start and saved in
# data/pds/openfederation.env: do not add AUTH_JWT_SECRET or
# KEY_ENCRYPTION_SECRET here, or the wizard will not start.

# --- Addresses (both must point at this server in DNS: A and/or AAAA records)
# The PDS. The setup wizard opens at https://<PDS_DOMAIN>/setup.
PDS_DOMAIN=pds.example.org
# The dashboard.
DASHBOARD_DOMAIN=dashboard.example.org
# Optional: the domain people's names go under (alice.example.org). Only
# pre-fills the wizard. For names to work, add the DNS record *.example.org
# pointing here; Caddy then fetches a certificate per name on first use.
HANDLE_DOMAIN=example.org

# --- Database password (only the PDS uses it; the database is never published).
# Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# --- Image version. "latest" follows every release; a version (for example
# 1.6.0) stays put until you change it here and run `docker compose pull`.
OPENFEDERATION_VERSION=latest

# --- Memory. Defaults fit a 2 GB server (PDS ~0.6 GB, database ~0.3 GB,
# dashboard ~0.2 GB, Caddy ~0.05 GB, leaving room for the system).
# With 4 GB or more: PDS_NODE_HEAP_MB=1024, POSTGRES_SHARED_BUFFERS=512MB,
# POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB.
PDS_NODE_HEAP_MB=512
DASHBOARD_NODE_HEAP_MB=192
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=512MB

# --- Rarely changed.
# Where the database, uploads, settings and certificates are kept.
DATA_DIR=./data
# Ports Caddy listens on. Public certificates need 80 and 443.
HTTP_PORT=80
HTTPS_PORT=443
